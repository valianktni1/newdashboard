# Copy this file to .env beside compose.yaml.
# Use a new password that is not used by any other service.
DASHBOARD_ADMIN_EMAIL=mark@perfectweddingsbymark.uk
DASHBOARD_ADMIN_PASSWORD=CHANGE-THIS-TO-A-NEW-LONG-PASSWORD
DASHBOARD_COOKIE_SECURE=true
DASHBOARD_SESSION_HOURS=12
DASHBOARD_ALLOWED_HOSTS=dashboard.weddingsbymark.uk,192.168.24.10,localhost,127.0.0.1
# Optional extra exact addresses permitted for availability checks. No redirects are followed.
# DASHBOARD_CHECK_URLS=["https://your-other-app.example/api/health"]
# Optional server-side connection to your booking app. Never use your admin password.
DASHBOARD_BOOKING_URL=https://booking.weddingsbymark.uk
# DASHBOARD_BOOKING_KEY=the-same-private-key-as-booking-CONTROL_CENTRE_KEY

# Optional independent planner account summary. Keep separate from Booking keys.
DASHBOARD_PLANNER_URL=https://planner.ivorydigital.uk
# DASHBOARD_PLANNER_KEY=the-same-key-as-planner-PLANNER_CONTROL_CENTRE_KEY
